# Freebox Environment Configuration
# Copy this file to .env and fill in your credentials

# ==========================================
# Telegram API Credentials
# Obtain these from https://my.telegram.org/
# ==========================================
APP_ID=
APP_HASH=
TG_PHONE=

# ==========================================
# Google Drive API Credentials
# Obtain these from Google Cloud Console
# ==========================================
GDRIVE_CLIENT_ID=
GDRIVE_CLIENT_SECRET=

# ==========================================
# Freebox Server Settings
# ==========================================
PORT=:8080
STREAM_PORT=:8090
DATA_DIR=./data
FREEBOX_PASSPHRASE=freebox-secret-passphrase
ADMIN_USER=admin
ADMIN_PASS=admin123
